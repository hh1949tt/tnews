# 复制为 .env 后按需填写（docker compose 会自动读取同目录的 .env）
# 该文件不要提交到 git（已在 .gitignore 里）

# 时区
TZ=Asia/Shanghai

# 首次启动时管理员 admin 的初始密码。
# 不填 = 随机生成，启动日志里会打印一次，同时写入 data/INITIAL_ADMIN_PASSWORD.txt
# TNEWS_ADMIN_PASSWORD=改成你自己的密码

# 可选：启用大模型润色口播稿（config.yaml 里 digest.llm.enabled 也要设为 true）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：自定义配置文件与数据目录（裸机部署时用）
# TNEWS_CONFIG=/etc/tnews/config.yaml
# TNEWS_DATA=/var/lib/tnews
# TNEWS_DB=/var/lib/tnews/tnews.db
